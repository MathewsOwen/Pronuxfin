DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pronuxfin"
# Com backend no mesmo Docker Compose que o postgres (host interno = postgres, não localhost):
# DATABASE_URL="postgresql://USER:SENHA@postgres:5432/pronuxfin"
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_SEC=604800
PORT=4000
FRONTEND_URL=http://localhost:3000

# Recuperação de senha por e-mail (produção: configure SMTP real)
# Ex.: SMTP_URL=smtps://user:pass@smtp.seudominio.com:465
SMTP_URL=
SMTP_FROM="PRONUXFIN <no-reply@pronuxfin.local>"

# Em dev, sem SMTP real, o link pode ser apenas logado no terminal do backend.
AUTH_RESET_DEV_LOG_ONLY=true
AUTH_RESET_TOKEN_TTL_MIN=30

# Express atrás de 1 proxy (nginx/Cloudflare) para req.ip / rate-limit usar IP real.
# Dev direto: omitir ou 0. Produção com proxy: 1.
# TRUST_PROXY=1

# BYOK: migração UserAiKeys na base acima — pasta backend: npm run prisma:migrate
