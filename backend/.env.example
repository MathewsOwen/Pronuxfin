DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pronuxfin"
# Com backend no mesmo Docker Compose que o postgres (host interno = postgres, não localhost):
# DATABASE_URL="postgresql://USER:SENHA@postgres:5432/pronuxfin"
JWT_SECRET="change-me-to-a-long-random-string-in-production"
# JWT_ALGORITHM=HS256|RS256   # RS256 = asymmetric (recommended in production)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Generate: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Access token curto (segundos). Renovação é feita pelo refresh token rotativo.
JWT_EXPIRES_SEC=3600
# Refresh token rotativo (segundos). Padrão 30 dias.
REFRESH_TOKEN_TTL_SEC=2592000
# Segredo partilhado Next(BFF) -> backend. Em produção, defina o MESMO valor aqui
# e em web/.env (INTERNAL_API_SECRET) para que /auth/* só aceite chamadas do BFF.
# INTERNAL_API_SECRET="gerar-string-aleatoria-longa"
PORT=4000
# Next dev usa 127.0.0.1:3000 — inclua ambas origens se alternar host
FRONTEND_URL=http://127.0.0.1:3000
# FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
# Origens CORS adicionais (vírgula ou ponto e vírgula). Deve incluir o domínio público do Next.
# FRONTEND_URLS=https://pronuxfin.com.br,https://www.pronuxfin.com.br

# E-mails de administrador (separados por vírgula ou ;). Login com um destes → isAdmin no /auth/me e JWT com role platform_admin.
# PLATFORM_ADMIN_EMAILS=voce@empresa.com

# Recuperação de senha por e-mail (produção: configure SMTP real)
# Ex.: SMTP_URL=smtps://user:pass@smtp.seudominio.com:465
SMTP_URL=
SMTP_FROM="PRONUXFIN <no-reply@pronuxfin.local>"

# Em dev, sem SMTP real, o link pode ser apenas logado no terminal do backend.
AUTH_RESET_DEV_LOG_ONLY=true
AUTH_RESET_TOKEN_TTL_MIN=30

# Express atrás de 1 proxy (nginx/Cloudflare) para req.ip / rate-limit usar IP real.
# Dev direto: omitir ou 0. Produção com proxy: 1.
# TRUST_PROXY=1

# BYOK: migração UserAiKeys na base acima — pasta backend: npm run prisma:migrate

# Rotação de segredos (INTERNAL_API_SECRET, JWT HS256/RS256): docs/SECURITY-OPERATIONS.md
# REFRESH_STRICT_BIND=1            # Revoga família se IP ou User-Agent mudar no refresh (recomendado prod)
# AUTH_LOGIN_NOTIFY=1              # E-mail em login de dispositivo novo (requer SMTP)
# WEBAUTHN_RP_ID=www.seudominio.com.br
# WEBAUTHN_ORIGIN=https://www.seudominio.com.br
# WEBAUTHN_RP_NAME=PRONUXFIN
