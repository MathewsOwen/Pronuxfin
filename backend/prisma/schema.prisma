generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String?
  /// Bumped to invalidate every previously issued access token at once
  /// (logout-all, password reset, suspected compromise).
  tokenVersion        Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aiKeys              UserAiKeys?
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  watchlistItems      UserWatchlistItem[]
  watchlistAlertRules UserWatchlistAlertRule[]
  watchlistSignals    UserWatchlistSignalHistory[]
  portfolioPositions  UserPortfolioPosition[]
  compoundScenarios   UserCompoundScenario[]
  financialRoutes     UserFinancialRoute[]
  financialRouteAlerts UserFinancialRouteAlert[]
  securityEvents       SecurityEvent[]
  webAuthnCredentials  WebAuthnCredential[]
  webAuthnChallenges   WebAuthnChallenge[]
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String?
  backedUp     Boolean   @default(false)
  transports   String?
  friendlyName String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

model WebAuthnChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  challenge  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

/// Chaves externas BYOK guardadas AES-256-GCM ( ciphertext em Base64 ).
model UserAiKeys {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openaiCipher  String?
  geminiCipher  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Rotating refresh tokens. The raw token never touches the DB — only its
/// SHA-256 hash. Rotation links each token to its replacement so that
/// presenting an already-rotated (revoked) token reveals theft and lets us
/// revoke the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex of the opaque refresh token.
  tokenHash    String    @unique
  /// Rotation lineage — all tokens minted from one login share a familyId.
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Id of the token that replaced this one on rotation (reuse detection).
  replacedById String?
  createdAt    DateTime  @default(now())
  userAgent    String?
  ip           String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model UserWatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId, createdAt])
}

model UserWatchlistAlertRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String   @default("*")
  ruleType  String
  threshold Float?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol, ruleType])
  @@index([userId, enabled])
  @@index([userId, symbol])
}

model UserWatchlistSignalHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  priority       Int
  attentionLevel String
  reasonsJson    Json
  newsCount      Int
  moveAbs        Float?
  rangeProgress  Int?
  createdAt      DateTime @default(now())

  @@index([userId, symbol, createdAt])
}

model UserPortfolioPosition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  region      String
  quantity    Float
  averageCost Float
  currency    String   @default("BRL")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId, updatedAt])
}

model UserCompoundScenario {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  payloadJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

model UserFinancialRoute {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String
  goalType            String
  targetAmount        Float
  targetDate          DateTime
  initialAmount       Float    @default(0)
  monthlyContribution Float
  assumedReturnPct    Float    @default(10)
  assumedInflationPct Float    @default(4.5)
  currency            String   @default("BRL")
  linkPortfolio       Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  alerts              UserFinancialRouteAlert[]

  @@index([userId, updatedAt])
}

model UserFinancialRouteAlert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId     String
  route       UserFinancialRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  alertType   String
  severity    String
  paramsJson  Json
  dismissedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, routeId, createdAt])
  @@index([userId, dismissedAt])
}
