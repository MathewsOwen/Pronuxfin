generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Espelha backend/prisma/schema.prisma (mantenha alinhado ao migrar).
model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aiKeys              UserAiKeys?
  passwordResetTokens PasswordResetToken[]
  watchlistItems      UserWatchlistItem[]
  watchlistAlertRules UserWatchlistAlertRule[]
  watchlistSignals    UserWatchlistSignalHistory[]
  portfolioPositions  UserPortfolioPosition[]
  compoundScenarios   UserCompoundScenario[]
  financialRoutes     UserFinancialRoute[]
  financialRouteAlerts UserFinancialRouteAlert[]
}

model UserAiKeys {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openaiCipher  String?
  geminiCipher  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model UserWatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  region    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId, createdAt])
}

model UserWatchlistAlertRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String   @default("*")
  ruleType  String
  threshold Float?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol, ruleType])
  @@index([userId, enabled])
  @@index([userId, symbol])
}

model UserWatchlistSignalHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol         String
  priority       Int
  attentionLevel String
  reasonsJson    Json
  newsCount      Int
  moveAbs        Float?
  rangeProgress  Int?
  createdAt      DateTime @default(now())

  @@index([userId, symbol, createdAt])
}

/// Posição em carteira simulada (quantidade + preço médio) — não integra corretora.
model UserPortfolioPosition {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  region      String
  quantity    Float
  averageCost Float
  currency    String   @default("BRL")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId, updatedAt])
}

/// Cenários salvos da calculadora de juros compostos (conta logada).
model UserCompoundScenario {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  payloadJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Meta patrimonial com navegação preventiva (GPS financeiro) — apenas planejamento simulado.
model UserFinancialRoute {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String
  goalType            String
  targetAmount        Float
  targetDate          DateTime
  initialAmount       Float    @default(0)
  monthlyContribution Float
  assumedReturnPct    Float    @default(10)
  assumedInflationPct Float    @default(4.5)
  currency            String   @default("BRL")
  linkPortfolio       Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  alerts              UserFinancialRouteAlert[]

  @@index([userId, updatedAt])
}

/// Alertas preventivos de desvio de rota (sem recomendação de ativos).
model UserFinancialRouteAlert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId     String
  route       UserFinancialRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  alertType   String
  severity    String
  paramsJson  Json
  dismissedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, routeId, createdAt])
  @@index([userId, dismissedAt])
}
