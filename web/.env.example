# =============================================================================
# PRONUXFIN — variáveis do frontend (Next.js / Vercel / `web/`)
# Copie para `.env.local` em desenvolvimento. Nunca commite `.env` ou `.env.local`.
# =============================================================================

# --- Obrigatório (auth e proxy para a API Nest) --------------------------------
# URL pública da API NestJS (sem barra final). Ex.: http://127.0.0.1:4000 (dev)
API_URL=http://127.0.0.1:4000

# Segredo partilhado com o backend (INTERNAL_API_SECRET). Quando definido nos dois
# lados, o backend só aceita /auth/* vindas deste BFF (ninguém burla o rate-limit).
# INTERNAL_API_SECRET=gerar-string-aleatoria-longa

# JWT no edge/SSR: HS256 (padrão) ou RS256 (só chave pública no web).
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- URL pública do site (SEO, OG, readiness em produção) --------------------
# Em dev pode omitir (usa http://localhost:3000). Em produção: domínio real.
# Deve coincidir com FRONTEND_URL no backend (links de e-mail, CORS).
# NEXT_PUBLIC_SITE_URL=https://www.pronuxfin.com.br

# --- Base de dados (watchlist, carteira, BYOK, /api/health/ready) ------------
# Mesma instância PostgreSQL do backend quando o Next persiste dados do utilizador.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pronuxfin

# Chave AES-256 (64 caracteres hex) para cifrar chaves BYOK na base.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AI_KEYS_ENCRYPTION_KEY=

# --- Mercado (obrigatório em produção para mesa “ao vivo” sem números inventados) ---
# BRAPI_TOKEN=                  # Cotações B3 — https://brapi.dev
# FMP_API_KEY=                  # Dossiê internacional + calendário — https://financialmodelingprep.com
# SHOW_MARKET_STATUS=1          # Dev: exibe o banner “Mercado parcial” mesmo sem chaves (opcional)
# FINANCIAL_MODELING_PREP_API_KEY=
# Com chave FMP, o provider ativa automaticamente (use MARKET_PROVIDER_FMP_ENABLED=false para desligar)
# MARKET_ALLOW_SIMULATION=1     # Só demos internas — NUNCA em go-live público (servidor)
# NEXT_PUBLIC_MARKET_ALLOW_SIMULATION=1  # Mesma política no cliente (strip); omitir em produção

# --- IA de mercado (opcional — servidor; utilizador pode usar BYOK no perfil) ---
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=
# PRONUX_OPENAI_MODEL=gpt-4o-mini
# PRONUX_GEMINI_MODEL=gemini-2.0-flash

# --- Ollama local (opcional) -------------------------------------------------
# PRONUX_MARKET_AI_OLLAMA_ORIGIN=http://127.0.0.1:11434
# PRONUX_MARKET_AI_MODEL=llama3.2

# --- Cookies / sessão ----------------------------------------------------------
# Produção (HTTPS): __Host-pronuxfin_at + __Secure-pronuxfin_rt (legado ainda lido).
# Dev HTTP: mantém pronuxfin_token / pronuxfin_refresh até COOKIE_SECURE=true.
# maxAge do cookie de access (s). Normalmente segue o expires_in do backend (~3600).
# JWT_COOKIE_MAX_AGE=3600
# maxAge do cookie de refresh (s). Padrão 30 dias.
# REFRESH_COOKIE_MAX_AGE=2592000
# COOKIE_SECURE=true

# --- Rate limit auth (opcional) ------------------------------------------------
# AUTH_RATE_LIMIT_LOGIN_MAX=25
# AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=60000

# --- Observabilidade (opcional) ------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# --- SEO verification (Google/Bing) --------------------------------------------
# Tokens vindos das tags de verificação do Search Console / Bing Webmaster.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Segurança / operação ------------------------------------------------------
# CSRF: cookie pronuxfin_csrf + header x-csrf-token (mutações autenticadas).
# CSRF_ENFORCE=0                     # Só debug local; em test desliga automaticamente
# AUTH_SESSION_VERSION_CHECK=0       # Desliga verificação JWT ver vs BD (só testes)
# COOKIE_SAMESITE_STRICT=1         # Refresh cookie SameSite=Strict (HTTPS)
# USER_MUTATION_RATE_LIMIT_MAX=40  # Mutações /api/user/* sensíveis por minuto
# Produção enterprise (recomendado):
# JWT_ALGORITHM=RS256
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
# AUTH_LOGIN_NOTIFY=1              # Alertas de login (SMTP no backend)
# WEBAUTHN_RP_ID=www.seudominio.com.br
# WEBAUTHN_ORIGIN=https://www.seudominio.com.br
# Ver docs/SECURITY-OPERATIONS.md (rotação INTERNAL_API_SECRET, JWT, BYOK).
# CSP_MODE=enforce|report-only|off   # prod default: enforce (nonce no middleware)
# CSP_MODE=report-only               # staging: log violations sem bloquear
# Staging: CSP_CHECK_URL=https://staging… npm run csp:check  (ver scripts/csp-staging-check.mjs)
# MARKET_FETCH_TIMEOUT_MS=12000      # BRAPI, Yahoo, CoinGecko, FMP, RSS
# LLM_FETCH_TIMEOUT_MS=90000         # OpenAI, Gemini, Ollama
# AUTH_UPSTREAM_TIMEOUT_MS=12000     # BFF → Nest auth
# HEALTH_PROBE_SECRET=          # Bearer para GET /api/health/ready (corpo com checks)
# SMOKE_STRICT=1                # Apenas para scripts/smoke.mjs — 503 em ready = FAIL
# COOKIE_SECURE=true            # Força cookie Secure fora de NODE_ENV=production

# --- Manutenção (produção) -----------------------------------------------------
# MAINTENANCE_FORCE_ON=1        # Bloqueia painel privado
# MAINTENANCE_FORCE_OFF=1       # Desliga gate de readiness mesmo em production

# =============================================================================
# Produção (Vercel) — mínimo para go-live
# =============================================================================
# API_URL=https://api.seudominio.com.br
# JWT_SECRET=<igual ao backend>
# NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
# DATABASE_URL=<postgresql gerido>
# AI_KEYS_ENCRYPTION_KEY=<64 hex>
# BRAPI_TOKEN=<token brapi.dev>
# FMP_API_KEY=<financialmodelingprep.com>
