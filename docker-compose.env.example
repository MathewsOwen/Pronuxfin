# Copie este ficheiro para `.env` na raiz do repositório (mesma pasta que docker-compose.yml).
# Docker Compose usa variáveis deste `.env` automaticamente ao fazer substitute no compose.
# Não envie `.env` para o Git — mantenha no servidor apenas.

POSTGRES_USER=pronuxfin
POSTGRES_PASSWORD=altere_para_uma_string_longa_em_producao
POSTGRES_DB=pronuxfin

# JWT do backend (assinatura dos cookies/session) — gere um segredo forte (>= 32 chars).
JWT_SECRET=

# Origin do frontend (Nest CORS) — URL pública da app Next (Vercel ou domínio próprio).
FRONTEND_URL=https://exemplo.vercel.app

# Opção útil nos logs/respostas `/health*` (staging | production | development).
APP_ENV=staging

# Porta só em loopback no host onde corre `docker-compose.prod.yml`.
API_PORT=4000

# Arranque do contentor da API: 1 = não executar `prisma migrate deploy` (só uso excecional).
SKIP_PRISMA_MIGRATE=0

# --- Observabilidade (Sentry, passo 7) ---
# Backend Nest (`src/instrument.ts`): sem `SENTRY_DSN` não envia eventos.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Frontend (Vercel / Next): mesmo projeto Sentry pode usar isto como DSN público no browser.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_APP_ENV=staging
# CSP Report-Only: inclui ingest Sentry em `connect-src`/`script-src` sem ter DSN no build (opcional).
# NEXT_PUBLIC_SENTRY_BUILD_CSP_HINT=1
