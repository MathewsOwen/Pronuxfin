{
  "name": "pronuxfin",
  "private": true,
  "scripts": {
    "dev:web": "npm run dev --prefix web",
    "dev:api": "npm run start:dev --prefix backend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build:web": "npm run build --prefix web",
    "build:api": "npm run build --prefix backend",
    "build": "npm run build:api && npm run build:web",
    "prisma:migrate": "npm run prisma:migrate --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
