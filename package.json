{
  "name": "pronuxfin",
  "private": true,
  "scripts": {
    "dev:web": "npm run dev --prefix web",
    "dev:api": "npm run start:dev --prefix backend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build:web": "npm run build --prefix web",
    "build:api": "npm run build --prefix backend",
    "build": "npm run build:api && npm run build:web",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "test": "npm run test --prefix web && npm test --prefix backend",
    "test:web": "npm run test --prefix web",
    "test:api": "npm test --prefix backend",
    "test:e2e": "npm run test:e2e --prefix web",
    "test:e2e:ci": "npm run build --prefix web && npm run test:e2e --prefix web",
    "test:e2e:install": "npm run test:e2e:install --prefix web",
    "validate": "node scripts/verify-env.mjs && npm run test:web && npm run typecheck --prefix web && npm test --prefix backend",
    "verify:env": "node scripts/verify-env.mjs",
    "repo:hygiene": "node scripts/repo-hygiene.mjs",
    "repo:hygiene:strict": "node scripts/repo-hygiene.mjs --strict",
    "smoke": "node scripts/smoke.mjs",
    "smoke:strict": "node scripts/smoke-strict.mjs",
    "smoke:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "smoke:sh": "bash scripts/smoke.sh",
    "release:check": "node scripts/release-readiness.mjs",
    "security:generate-secrets": "node scripts/generate-production-secrets.mjs",
    "production:setup": "node scripts/setup-pronuxfin-production.mjs",
    "production:patch-env": "node scripts/patch-production-env-file.mjs",
    "production:probe": "node scripts/probe-production-readiness.mjs",
    "production:verify": "node scripts/verify-production-config.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
